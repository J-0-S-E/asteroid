#!/usr/bin/env bash
# Keeps one pre-started asteroid instance waiting in the background so the
# screenshot key skips the Quickshell startup. When an instance has been used and
# exits, a new one is started. Run it from Hyprland autostart.
# Part of asteroid, forked from ryoshot in Ryoku (GPL-3.0).
export PATH="$HOME/.local/bin:$PATH"
export ASTEROID_STANDBY=1 ASTEROID_PRECAPTURED=1
if [[ -n ${ASTEROID_DIR:-} ]]; then qs_cmd=(qs -p "$ASTEROID_DIR"); else qs_cmd=(qs -c asteroid); fi

if [[ -z ${XDG_PICTURES_DIR:-} ]]; then
  pics=$(xdg-user-dir PICTURES 2>/dev/null || true)
  [[ -n $pics && $pics != "$HOME" ]] || pics="$HOME/Pictures"
  export XDG_PICTURES_DIR=$pics
fi

# Started from Hyprland autostart, WAYLAND_DISPLAY can still be empty and qs would
# die at once. Take the socket from Hyprland and wait until it exists.
until [[ -n ${WAYLAND_DISPLAY:-} && -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/$WAYLAND_DISPLAY ]]; do
  WAYLAND_DISPLAY=$(hyprctl instances -j 2>/dev/null | jq -r --arg s "${HYPRLAND_INSTANCE_SIGNATURE:-}" '.[] | select(.instance == $s) | .wl_socket')
  export WAYLAND_DISPLAY
  [[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/$WAYLAND_DISPLAY ]] || sleep 1
done

exec 9>/tmp/asteroid-standby.lock
flock -n 9 || exit 0   # only one standby loop

while true; do
  start=$SECONDS
  "${qs_cmd[@]}" >/dev/null 2>&1
  # An instance that dies at once backs off instead of spinning
  if (( SECONDS - start < 2 )); then sleep 5; else sleep 0.3; fi
done
